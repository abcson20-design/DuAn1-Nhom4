# ==============================================================
# NEXVORA STORE - MẪU BIẾN MÔI TRƯỜNG (.env.example)
# Sao chép tệp này thành .env và điền thông tin thực tế của bạn
# ==============================================================

APP_ENV=production
APP_DEBUG=false
APP_URL=
ALLOWED_HOSTS=localhost,127.0.0.1,::1,localhost:8000,localhost:8080

# CẤU HÌNH DATABASE
DB_HOST=localhost
DB_PORT=3306
DB_NAME=DuAn1_db
DB_USER=root
DB_PASS=

# TÀI KHOẢN NGÂN HÀNG VIETQR
BANK_ID=ICB
BANK_NAME="VietinBank - Ngân hàng TMCP Công Thương Việt Nam"
BANK_ACCOUNT_NO=101883603231
BANK_ACCOUNT_NAME="LE VAN SON"
VIETQR_TEMPLATE=compact

# CỔNG THANH TOÁN SEPAY
SEPAY_ENABLED=true
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_IPN_SECRET=
SEPAY_RECONCILE_ON_RETURN=true
